# Copy this file to .env.local for local testing. On Vercel, add each key in Settings > Environment Variables.

# OPTIONAL. The site detects its own address. Only set it if you want to force one, e.g. https://brandsmith.studio
NEXT_PUBLIC_SITE_URL=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys (start with the TEST keys: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe > Webhooks > your destination > Signing secret (whsec_...). Added after the first deploy (INSTALLATION.md step 6).
STRIPE_WEBHOOK_SECRET=

# Resend > API Keys
RESEND_API_KEY=
# OPTIONAL until you verify your domain in Resend. Then e.g. Brandsmith <hello@brandsmith.studio>
# Without it, Resend's test sender is used: emails only reach your Resend account's own address.
EMAIL_FROM=

# Emails allowed to open /admin (comma separated)
ADMIN_EMAILS=
