# Copy this file to .env.local for local testing. On Vercel, add each key in Settings > Environment Variables.

# Your site address (no slash at the end), e.g. https://brandsmith.studio
NEXT_PUBLIC_SITE_URL=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys (start with the TEST keys: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Resend > API Keys
RESEND_API_KEY=
# The sender of your emails, e.g. Brandsmith <hello@brandsmith.studio> (domain verified in Resend)
EMAIL_FROM=

# Emails allowed to open /admin (comma separated)
ADMIN_EMAILS=
